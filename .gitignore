.env
.env.*
!.env.example

# sqlite and local databases
*.db
*.db-journal
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
prisma/*.db
prisma/*.db-journal

# backups and database dumps (specific patterns)
*.dump
*.bak
*.backup
*.sql.gz
*.tar.gz

# ensure prisma migration sql files are tracked
!prisma/migrations/**/*.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
